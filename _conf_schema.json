          "default": 0.15
        },
        "end_cultivation": {
          "description": "出关后",
          "type": "float",
          "default": 0.1
        },
        "rift_complete": {
          "description": "秘境探索完成后",
          "type": "float",
          "default": 0.2
        },
        "bounty_complete": {
          "description": "悬赏完成后",
          "type": "float",
          "default": 0.25
        },
        "boss_fight": {
          "description": "Boss战斗后",
          "type": "float",
          "default": 0.3
        },
        "dungeon_advance": {
          "description": "副本推进后（预留）",
          "type": "float",
          "default": 0.15
        },
        "farm_harvest": {
          "description": "灵田收取后",
          "type": "float",
          "default": 0.1
        },
        "farm_sow": {
          "description": "灵田播种后",
          "type": "float",
          "default": 0.08
        }
      }
    }
  },
  "GARDEN": {
    "STEAL_ENABLED": {
      "description": "偷菜玩法开关",
