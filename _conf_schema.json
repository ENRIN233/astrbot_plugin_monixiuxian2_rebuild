      "default": true,
      "hint": "关闭后所有玩家不再触发奇遇（因果与历史保留）"
    },
    "DAILY_LIMIT": {
      "description": "每人每日奇遇次数上限",
      "type": "int",
      "default": 3,
      "hint": "推荐 3 次；超限后当天不再触发"
    },
    "CHOICE_TIMEOUT_SECONDS": {
      "description": "奇遇选择超时（秒）",
      "type": "int",
      "default": 180,
      "hint": "超时不消耗当日次数"
    },
    "EXP_RATIO": {
      "description": "奇遇修为占比系数",
      "type": "float",
      "default": 0.15,
      "obvious_hint": true,
      "hint": "每天全部奇遇的修为期望 ≈ 玩家每日修为 × 此系数；建议 0.10~0.20"
    },
    "GOLD_SCALE": {
      "description": "奇遇灵石全局倍率",
      "type": "float",
      "default": 1.0,
      "obvious_hint": true,
      "hint": "应急旋钮：1.0 为设计值，可在 0.6~1.5 间调节"
    },
    "LEGENDARY_BROADCAST": {
      "description": "传说级奇遇全服匿名广播",
