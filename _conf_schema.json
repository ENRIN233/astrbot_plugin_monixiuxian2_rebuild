{
  "ACCESS_CONTROL": {
    "description": "访问控制",
    "type": "object",
    "items": {
      "WHITELIST_GROUPS": {
        "description": "白名单群号列表",
        "type": "list",
        "default": [],
        "hint": "请添加允许使用此插件的QQ群号。留空则表示所有群聊都可用。"
      },
      "BOSS_ADMINS": {
        "description": "Boss管理员名单",
        "type": "list",
        "default": [],
        "hint": "可以手动生成Boss的用户ID（字符串）。为空则不允许任何人手动生成Boss。"
      },
      "BOSS_ENABLED": {
        "description": "是否启用Boss系统",
        "type": "bool",
        "default": true,
        "hint": "开启后每小时自动生成世界Boss并全服广播，玩家可挑战获取灵石与锻造材料。关闭将停止定时生成并禁用挑战。老版本部署若已保存过配置，需在插件配置中手动开启。"
      }
    }
  },
  "VALUES": {
    "description": "核心数值配置",
    "type": "object",
    "items": {
      "INITIAL_GOLD": {
        "description": "初始灵石",
        "type": "int",
        "default": 100,
        "hint": "新玩家创建角色时获得的初始灵石数量。"
      },
      "BASE_EXP_PER_MINUTE": {
        "description": "闭关基础修为（每分钟）",
        "type": "int",
        "default": 60,
        "hint": "闭关修炼时，每分钟获得的基础修为值（会受灵根倍率影响）。"
      },
      "CHECK_IN_GOLD": {
        "description": "签到灵石奖励",
        "type": "int",
        "default": 500000,
        "hint": "每日签到获得的固定灵石数量。v2调整为500,000。"
      }
    }
  },
  "SPIRIT_ROOT_SPEEDS": {
    "description": "灵根修炼速度倍率",
    "type": "object",
    "items": {
      "PSEUDO_ROOT_SPEED": {
        "description": "伪灵根（废灵根）",
