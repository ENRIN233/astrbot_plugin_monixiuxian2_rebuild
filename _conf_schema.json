{
  "ACCESS_CONTROL": {
    "description": "访问控制",
    "type": "object",
    "items": {
      "WHITELIST_GROUPS": {
        "description": "白名单群号列表",
        "type": "list",
        "default": [],
        "hint": "请添加允许使用此插件的QQ群号。留空则表示所有群聊都可用。"
      },
      "BOSS_ADMINS": {
        "description": "Boss管理员名单",
        "type": "list",
        "default": [],
        "hint": "可以手动生成Boss的用户ID（字符串）。为空则不允许任何人手动生成Boss。"
      },
      "BOSS_ENABLED": {
        "description": "是否启用Boss系统",
        "type": "bool",
        "default": false,
        "hint": "关闭后将停止Boss定时生成，玩家无法挑战Boss。已存在的Boss不会被清除。"
      }
    }
  },
  "VALUES": {
    "description": "核心数值配置",
    "type": "object",
    "items": {
      "INITIAL_GOLD": {
        "description": "初始灵石",
        "type": "int",
        "default": 100,
        "hint": "新玩家创建角色时获得的初始灵石数量。"
      },
      "BASE_EXP_PER_MINUTE": {
        "description": "闭关基础修为（每分钟）",
        "type": "int",
        "default": 60,
        "hint": "闭关修炼时，每分钟获得的基础修为值（会受灵根倍率影响）。"
      },
      "CHECK_IN_GOLD_MIN": {
        "description": "签到灵石奖励（最小值）",
        "type": "int",
        "default": 50,
        "hint": "每日签到获得的最少灵石数量。"
      },
      "CHECK_IN_GOLD_MAX": {
        "description": "签到灵石奖励（最大值）",
        "type": "int",
        "default": 500,
        "hint": "每日签到获得的最多灵石数量。"
      },
      "BREAKTHROUGH_DEATH_PROBABILITY": {
        "description": "突破失败死亡概率范围",
        "type": "list",
        "default": [0.01, 0.1],
        "hint": "突破失败时的死亡概率范围。第一个值为最小概率（1%），第二个值为最大概率（10%）。每次突破失败会在此范围内随机一个死亡概率。"
      }
    }
  },
  "SPIRIT_ROOT_SPEEDS": {
    "description": "灵根修炼速度倍率",
    "type": "object",
    "items": {
      "PSEUDO_ROOT_SPEED": {
        "description": "伪灵根（废灵根）",
        "type": "float",
        "default": 0,
        "hint": "资质最差，无法修炼。"
      },
      "TRUE_ROOT_SPEED": {
        "description": "真灵根（多灵根组合）",
        "type": "float",
        "default": 1.0,
        "hint": "双灵根、三灵根、四灵根等多元素组合，修炼速度正常。"
      },
      "WUXING_ROOT_SPEED": {
        "description": "五行单灵根（真灵根）",
        "type": "float",
        "default": 1.0,
        "hint": "金、木、水、火、土单一灵根，修炼速度正常。"
      },
      "THUNDER_ROOT_SPEED": {
        "description": "雷灵根（变异灵根）",
        "type": "float",
        "default": 1.2,
        "hint": "天地雷霆之力，变异灵根，稀有。"
      },
      "ICE_ROOT_SPEED": {
        "description": "冰灵根（变异灵根）",
        "type": "float",
        "default": 1.2,
        "hint": "极寒冰封之力，变异灵根，稀有。"
      },
      "WIND_ROOT_SPEED": {
        "description": "风灵根（变异灵根）",
        "type": "float",
        "default": 1.2,
        "hint": "疾风迅雷之力，变异灵根，稀有。"
      },
      "DARK_ROOT_SPEED": {
        "description": "暗灵根（变异灵根）",
        "type": "float",
        "default": 1.2,
        "hint": "幽暗深邃之力，变异灵根，稀有。"
      },
      "LIGHT_ROOT_SPEED": {
        "description": "光灵根（变异灵根）",
        "type": "float",
        "default": 1.2,
        "hint": "神圣光明之力，变异灵根，稀有。"
      },
      "HEAVENLY_ROOT_SPEED": {
        "description": "天灵根",
        "type": "float",
        "default": 1.3,
        "hint": "天选之子，单一属性的极致，极其稀有。"
      },
      "DRAGON_ROOT_SPEED": {
        "description": "龙灵根",
        "type": "float",
        "default": 1.4,
        "hint": "龙族血脉，掌控空间、时间、言灵之力。"
      },
      "SUPER_ROOT_SPEED": {
        "description": "超灵根",
        "type": "float",
        "default": 1.5,
        "hint": "日月双辉，超越天灵根的稀有存在。"
      },
      "FUSION_ROOT_SPEED": {
        "description": "融合灵根",
        "type": "float",
        "default": 1.7,
        "hint": "五行融合，万法归一，传说级灵根。"
      },
      "CHAOS_ROOT_SPEED": {
        "description": "混沌灵根",
        "type": "float",
        "default": 2.0,
        "hint": "混沌初开，包罗万象，神话级灵根。"
      },
      "MECH_CORE_SPEED": {
        "description": "机械核心",
        "type": "float",
        "default": 2.3,
        "hint": "超越灵根的机械之力，科技与修仙的融合。"
      },
      "OTHERWORLD_SPEED": {
        "description": "异世界之力",
        "type": "float",
        "default": 2.5,
        "hint": "来自异世界的神秘力量，不受此界法则约束。"
      },
      "REINCARNATION_SPEED": {
        "description": "轮回道果",
        "type": "float",
        "default": 4.0,
        "hint": "历经轮回所证之道果，蕴含无穷造化。"
      },
      "TRUE_REINCARNATION_SPEED": {
        "description": "真·轮回道果",
        "type": "float",
        "default": 5.0,
        "hint": "真正证得的轮回道果，修炼速度登峰造极。"
      }
    }
  },
  "SPIRIT_ROOT_WEIGHTS": {
    "description": "灵根抽取权重配置",
    "type": "object",
    "items": {
      "PSEUDO_ROOT_WEIGHT": {
        "description": "伪灵根权重（25%）",
        "type": "int",
        "default": 2500,
        "hint": "权重越高，抽到的概率越大。"
      },
      "TRUE_ROOT_WEIGHT": {
        "description": "真灵根权重（10%）",
        "type": "int",
        "default": 1000,
        "hint": "权重越高，抽到的概率越大。"
      },
      "VARIANT_ROOT_WEIGHT": {
        "description": "变异灵根权重（雷/冰/风/暗/光，18%）",
        "type": "int",
        "default": 1800,
        "hint": "权重越高，抽到的概率越大。"
      },
      "HEAVENLY_ROOT_WEIGHT": {
        "description": "天灵根权重（18%）",
        "type": "int",
        "default": 1800,
        "hint": "权重越高，抽到的概率越大。"
      },
      "DRAGON_ROOT_WEIGHT": {
        "description": "龙灵根权重（13%）",
        "type": "int",
        "default": 1300,
        "hint": "权重越高，抽到的概率越大。"
      },
      "SUPER_ROOT_WEIGHT": {
        "description": "超灵根权重（10%）",
        "type": "int",
        "default": 1000,
        "hint": "权重越高，抽到的概率越大。"
      },
      "FUSION_ROOT_WEIGHT": {
        "description": "融合灵根权重（6%）",
        "type": "int",
        "default": 600,
        "hint": "权重越高，抽到的概率越大。"
      },
      "CHAOS_ROOT_WEIGHT": {
        "description": "混沌灵根权重（3%）",
        "type": "int",
        "default": 300,
        "hint": "权重越高，抽到的概率越大。"
      },
      "MECH_ROOT_WEIGHT": {
        "description": "机械核心权重（1%）",
        "type": "int",
        "default": 100,
        "hint": "权重越高，抽到的概率越大。"
      },
      "OTHERWORLD_ROOT_WEIGHT": {
        "description": "异世界之力权重（1%）",
        "type": "int",
        "default": 100,
        "hint": "权重越高，抽到的概率越大。"
      }
    }
  },
  "FILES": {
    "description": "文件路径配置",
    "type": "object",
    "items": {
      "DATABASE_FILE": {
        "description": "数据库文件名",
        "type": "string",
        "default": "xiuxian_data_lite.db",
        "hint": "存储玩家数据的SQLite数据库文件名，数据库将存储在 data/plugin_data/{插件名}/ 目录下。"
      }
    }
  },
  "TRADE": {
    "description": "玩家交易 & 寄售行配置（v3.2.0 新增）",
    "type": "object",
    "items": {
      "TRADE_TIMEOUT_SECONDS": {
        "description": "交易超时时间（秒）",
        "type": "int",
        "default": 1800,
        "hint": "交易超过该时间未完成将自动取消并退还托管物品/灵石。默认 1800 秒（30 分钟）。"
      },
      "TRADE_CHECK_INTERVAL_SECONDS": {
        "description": "交易超时扫描间隔（秒）",
        "type": "int",
        "default": 300,
        "hint": "后台定时检查超时交易的间隔。默认 300 秒（5 分钟）。设置过短会增加数据库压力。"
      },
      "CONSIGNMENT_FEE_RATE": {
        "description": "寄售行上架手续费比例",
        "type": "float",
        "default": 0.05,
        "hint": "卖家上架物品时扣除的灵石比例（0.05 = 5%）。手续费在物品下架/过期时不退还。"
      },
      "CONSIGNMENT_DURATION_DAYS": {
        "description": "寄售物品在架天数",
        "type": "int",
        "default": 7,
        "hint": "寄售物品在架天数。超过该时长未售出会自动下架并退回卖家库存（手续费不退）。"
      },
      "CONSIGNMENT_CHECK_INTERVAL_SECONDS": {
        "description": "寄售过期扫描间隔（秒）",
        "type": "int",
        "default": 3600,
        "hint": "后台定时检查寄售过期的间隔。默认 3600 秒（1 小时）。"
      }
    }
  }
}
