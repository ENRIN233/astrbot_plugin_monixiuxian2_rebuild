        "hint": "双灵根、三灵根、四灵根等多元素组合，修炼速度正常。"
      },
      "WUXING_ROOT_SPEED": {
        "description": "五行单灵根（真灵根）",
        "type": "float",
        "default": 1.1,
        "hint": "金、木、水、火、土单一灵根，修炼速度提升10%。"
      },
      "THUNDER_ROOT_SPEED": {
        "description": "雷灵根（变异灵根）",
        "type": "float",
        "default": 1.2,
        "hint": "天地雷霆之力，变异灵根，稀有。"
      },
      "ICE_ROOT_SPEED": {
        "description": "冰灵根（变异灵根）",
        "type": "float",
        "default": 1.2,
        "hint": "极寒冰封之力，变异灵根，稀有。"
      },
      "WIND_ROOT_SPEED": {
        "description": "风灵根（变异灵根）",
        "type": "float",
        "default": 1.2,
        "hint": "疾风迅雷之力，变异灵根，稀有。"
      },
      "DARK_ROOT_SPEED": {
        "description": "暗灵根（变异灵根）",
        "type": "float",
        "default": 1.2,
        "hint": "幽暗深邃之力，变异灵根，稀有。"
      },
      "LIGHT_ROOT_SPEED": {
        "description": "光灵根（变异灵根）",
        "type": "float",
        "default": 1.2,
        "hint": "神圣光明之力，变异灵根，稀有。"
      },
      "HEAVENLY_ROOT_SPEED": {
        "description": "天灵根",
        "type": "float",
        "default": 1.3,
        "hint": "天选之子，单一属性的极致，极其稀有。"
      },
      "DRAGON_ROOT_SPEED": {
        "description": "龙灵根",
        "type": "float",
        "default": 1.4,
        "hint": "龙族血脉，掌控空间、时间、言灵之力。"
      },
      "SUPER_ROOT_SPEED": {
        "description": "超灵根",
        "type": "float",
        "default": 1.5,
        "hint": "日月双辉，超越天灵根的稀有存在。"
      },
      "FUSION_ROOT_SPEED": {
        "description": "融合灵根",
        "type": "float",
        "default": 1.7,
        "hint": "五行融合，万法归一，传说级灵根。"
      },
      "CHAOS_ROOT_SPEED": {
        "description": "混沌灵根",
        "type": "float",
        "default": 2.0,
        "hint": "混沌初开，包罗万象，神话级灵根。"
      },
      "MECH_CORE_SPEED": {
        "description": "机械核心",
        "type": "float",
        "default": 2.3,
        "hint": "超越灵根的机械之力，科技与修仙的融合。"
      },
      "OTHERWORLD_SPEED": {
        "description": "异世界之力",
        "type": "float",
        "default": 2.5,
        "hint": "来自异世界的神秘力量，不受此界法则约束。"
      },
      "REINCARNATION_SPEED": {
        "description": "轮回道果",
        "type": "float",
        "default": 4.0,
        "hint": "历经轮回所证之道果，蕴含无穷造化。"
      },
      "TRUE_REINCARNATION_SPEED": {
        "description": "真·轮回道果",
        "type": "float",
        "default": 5.0,
        "hint": "真正证得的轮回道果，修炼速度登峰造极。"
      }
    }
  },
  "SPIRIT_ROOT_WEIGHTS": {
